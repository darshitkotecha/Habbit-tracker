rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'points', 'tier']) &&
             data.uid == request.auth.uid &&
             data.name is string &&
             data.points is int &&
             data.tier in ['Initiate', 'Habit Builder', 'Lifestyle Builder', 'Identity Builder'];
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /users/{userId}/habits/{habitLogId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members);
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
    }

    match /rewards/{rewardId} {
      allow read: if isSignedIn();
    }
  }
}
